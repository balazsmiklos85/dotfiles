#!/usr/bin/env bash
set -euo pipefail

declare -A PRICING=(
  [claude-fable-5]="10.0 50.0 1.00 12.50"
  [claude-opus-4]="15.0 75.0 1.50 18.75"
  [claude-opus-4-1]="15.0 75.0 1.50 18.75"
  [claude-opus-4-5]="5.0 25.0 0.50 6.25"
  [claude-opus-4-6]="5.0 25.0 0.50 6.25"
  [claude-opus-4-7]="5.0 25.0 0.50 6.25"
  [claude-opus-4-8]="5.0 25.0 0.50 6.25"
  [claude-opus-5]="5.0 25.0 0.50 6.25"
  [claude-sonnet-4]="3.0 15.0 0.30 3.75"
  [claude-sonnet-4-5]="3.0 15.0 0.30 3.75"
  [claude-sonnet-4-6]="3.0 15.0 0.30 3.75"
  [claude-sonnet-5]="3.0 15.0 0.30 3.75"
  [claude-haiku-3]="0.25 1.25 0.03 0.30"
  [claude-haiku-3-5]="0.80 4.0 0.08 1.0"
  [claude-haiku-4-5]="1.0 5.0 0.10 1.25"
)

declare -A TOTAL=()

file_path="$HOME/.claude/stats-cache.json"
while IFS=$'\t' read -r full_name in_tok out_tok cr_tok cc_tok; do
  name="$(echo "$full_name" | sed -E 's/^.*claude-/claude-/; s/^(claude-(opus|sonnet|haiku)-[0-9]+-[0-9]+).*/\1/')"

  TOTAL[$name,input]=$(( ${TOTAL[$name,input]:-0} + in_tok ))
  TOTAL[$name,output]=$(( ${TOTAL[$name,output]:-0} + out_tok ))
  TOTAL[$name,cache_read]=$(( ${TOTAL[$name,cache_read]:-0} + cr_tok ))
  TOTAL[$name,cache_creat]=$(( ${TOTAL[$name,cache_creat]:-0} + cc_tok ))
done < <(jq -r '.modelUsage | to_entries | sort_by(.key) | .[] | [.key, .value.inputTokens, .value.outputTokens, .value.cacheReadInputTokens, .value.cacheCreationInputTokens] | @tsv' "$file_path")

{
  for key in "${!TOTAL[@]}"; do
    model="${key%,*}"
    read -r r_in r_out r_cr r_cc <<< "${PRICING[$model]:-0 0 0 0}"

    case "$key" in *,input) ;; *) continue ;; esac

    printf '%s %d %d %d %d %s %s %s %s\n' \
      "$model" \
      "${TOTAL[$model,input]}" \
      "${TOTAL[$model,output]}" \
      "${TOTAL[$model,cache_read]}" \
      "${TOTAL[$model,cache_creat]}" \
      "$r_in" "$r_out" "$r_cr" "$r_cc"
  done
} | awk '
    BEGIN {
      printf "%-72s\n", "------------------------------------------------------------------------"
      printf "%-20s | %-10s | %-10s | %-10s\n", "Model Family", "Input (M)", "Output (M)", "Cost (USD)"
      printf "%-72s\n", "------------------------------------------------------------------------"
      grand = 0
    }
    {
      im = $2 / 1000000.0
      om = $3 / 1000000.0
      cost = ($2*$6 + $3*$7 + $4*$8 + $5*$9) / 1000000.0
      printf "%-20s | %-10.4f | %-10.4f | $%-9.2f\n", $1, im, om, cost
      grand += cost
    }
    END {
      printf "%-72s\n", "------------------------------------------------------------------------"
      printf "GRAND TOTAL COST: $%.2f\n", grand
    }
    '

saved=$(sqlite3 "$HOME/.codex/state_5.sqlite" "SELECT printf('%.2f', t/1000000.0 + t*0.09362934/200000.0) FROM (SELECT COALESCE(SUM(CASE WHEN model LIKE '%qwen%' OR model LIKE '%gemma%' THEN tokens_used ELSE 0 END), 0) AS t FROM threads)")
printf 'Saved: ~$%s\n' "$saved"
