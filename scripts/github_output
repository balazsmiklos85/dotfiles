#!/usr/bin/env bash
set -euo pipefail

die() { echo "$*" >&2; exit 1; }

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
[[ -n "$branch" ]] || die "Could not detect branch name. Are you in a git repository?"

runs="$(gh run list --branch "$branch" --status failure --limit 1 --json databaseId)"
if [[ "$runs" == "[]" ]]; then
    die "No failed runs found for branch '$branch'."
fi

run_id="$(printf '%s' "$runs" | jq -r '.[0].databaseId')"

run_data="$(gh run view "$run_id" --json jobs)"

failed_jobs="$(printf '%s' "$run_data" | jq -r '.jobs[] | select(.conclusion == "failure") | .databaseId')"
[[ -n "$failed_jobs" ]] || die "No specific failing jobs were found."

while IFS= read -r job_id; do
    gh run view --job "$job_id" --log
done <<< "$failed_jobs"
