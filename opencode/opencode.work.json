{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "explore": {
            "model": "ollama/qwen3.6:35b",
            "permission": {
                "external_directory": {
                    "~/projects/**": "allow"
                }
            }
        },
        "general": {
            "model": "ollama/qwen3.6:35b"
        },
        "scout": {
            "model": "ollama/qwen3.6:35b",
            "permission": {
                "external_directory": {
                    "~/.gradle/**": "allow",
                    "~/projects/**": "allow",
                    "/tmp": "allow"
                }
            }
        }
    },
    "permission": {
        "edit": "ask",
        "bash": {
            "rtk curl *": "allow",
            "rtk docker *": "allow",
            "rtk git diff*": "allow",
            "rtk git log *": "allow",
            "rtk git show *": "allow",
            "rtk git status*": "allow",
            "rtk gh *": "allow",
            "rtk gradlew *": "allow",
            "rtk rg *": "allow"
        },
        "external_directory": {
            "*": "deny",
            "~/.config/opencode": "ask",
            "~/.config/claude": "ask"
        }
    },
    "model": "ollama/qwen3.8:27b",
    "mcp": {
        "lightdash": {
            "enabled": false,
            "type": "remote",
            "url": "https://agentic-gateway-analytics.tw.ee/internal-mcp/lightdash"
        }
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:11434/v1",
                "maxTokens": 4096,
                "contextWindow": 131072
            },
            "models": {
                "qwen3.8:27b": {
                    "name": "Qwen 3.8 27B",
                    "limit": {
                        "context": 131072,
                        "output": 8192
                    }
                },
                "qwen3.6:35b": {
                    "name": "Qwen 3.6 35B",
                    "limit": {
                        "context": 131072,
                        "output": 8192
                    }
                }
            }
        }
    }
}
