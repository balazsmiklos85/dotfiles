{
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "status_bar": {
    "active_language_button": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "show_turn_stats": true,
    "sidebar_side": "right",
    "dock": "left",
    "default_profile": "ask",
    "default_model": {
      "model": "ornith-1.0-35b",
      "provider": "lmstudio",
    },
  },
  "buffer_font_family": "DejaVu Sans Mono",
  "buffer_font_size": 14,
  "icon_theme": "Catppuccin Mocha",
  "languages": {
    "Ruby": {
      "wrap_guides": [120],
    },
  },
  "soft_wrap": "editor_width",
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "dark",
  },
  "ui_font_size": 16,
  "vim": {
    "use_system_clipboard": "always",
  },
  "vim_mode": true,
}
